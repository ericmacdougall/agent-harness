+#[derive(Deserialize)]
+struct ModelObservationEvent<'a> {
+    #[serde(borrow)]
+    response_id: Option<&'a RawValue>,
+    #[serde(borrow)]
+    response: Option<ModelObservationResponse<'a>>,
+    headers: Option<ObservedModelHeaders>,
+}
+
+#[derive(Deserialize)]
+struct ModelObservationResponse<'a> {
+    #[serde(borrow)]
+    id: Option<&'a RawValue>,
+    #[serde(borrow)]
+    model: Option<&'a RawValue>,
+    #[serde(borrow)]
+    status: Option<&'a RawValue>,
+    headers: Option<ObservedModelHeaders>,
+}
+
+struct ObservedModelHeaders([Option<String>; 2]);
+
+impl<'de> Deserialize<'de> for ObservedModelHeaders {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Headers;
+
+        impl<'de> Visitor<'de> for Headers {
+            type Value = ObservedModelHeaders;
+
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("a unique set of model headers")
+            }
+
+            fn visit_map<M: MapAccess<'de>>(self, mut map: M) -> Result<Self::Value, M::Error> {
+                let mut models = [None, None];
+                while let Some(name) = map.next_key::<String>()? {
+                    let i = if name.eq_ignore_ascii_case("openai-model") {
+                        0
+                    } else if name.eq_ignore_ascii_case("x-openai-model") {
+                        1
+                    } else {
+                        map.next_value::<IgnoredAny>()?;
+                        continue;
+                    };
+                    if models[i].is_some() {
+                        return Err(serde::de::Error::custom("duplicate model header"));
+                    }
+                    let value = map.next_value::<String>()?;
+                    if value.len() > 96 {
+                        return Err(serde::de::Error::custom("oversized model header"));
+                    }
+                    models[i] = Some(value);
+                }
+                Ok(ObservedModelHeaders(models))
+            }
+        }
+
+        deserializer.deserialize_map(Headers)
+    }
+}
+
+/// Each instance belongs to a single upstream request, never the lifetime of a WebSocket.
+#[derive(Default)]
+pub(crate) struct ResponseModelTracker {
+    response_id: Option<String>,
+    observation: Option<ResponseModelObservation>,
+    invalid: bool,
+    completed: bool,
+}
+
+impl ResponseModelTracker {
+    fn from_http(headers: &HeaderMap) -> Self {
+        let mut tracker = Self::default();
+        for name in ["openai-model", "x-openai-model"] {
+            for value in headers.get_all(name).iter() {
+                tracker.observe_model(value.to_str().ok(), ResponseModelSource::HttpResponseHeader);
+            }
+        }
+        tracker
+    }
+
+    fn observe_model(&mut self, model: Option<&str>, source: ResponseModelSource) {
+        let Some(model) = model.filter(|s| {
+            !s.is_empty()
+                && s.len() <= 96
+                && s.as_bytes()[0].is_ascii_alphanumeric()
+                && s.bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || b".-_".contains(&c))
+        }) else {
+            self.invalid = true;
+            return;
+        };
+        match &self.observation {
+            Some(previous) if previous.model != model => self.invalid = true,
+            Some(_) => (),
+            None => {
+                self.observation = Some(ResponseModelObservation {
+                    model: model.to_owned(),
+                    source,
+                });
+            }
+        }
+    }
+
+    fn observe_headers(&mut self, headers: Option<&ObservedModelHeaders>) {
+        if let Some(headers) = headers {
+            for value in headers.0.iter().flatten() {
+                self.observe_model(Some(value), ResponseModelSource::ResponseHeader);
+            }
+        }
+    }
+
+    fn bind_id(&mut self, id: &str) -> bool {
+        if id.is_empty()
+            || id.len() > 128
+            || self.response_id.as_deref().is_some_and(|known| known != id)
+        {
+            self.invalid = true;
+            return false;
+        }
+        if self.response_id.is_none() {
+            self.response_id = Some(id.to_owned());
+        }
+        true
+    }
+
+    fn observe_event(&mut self, kind: &str, raw: &str) {
+        if !matches!(
+            kind,
+            "response.created" | "response.metadata" | "response.completed"
+        ) {
+            return;
+        }
+        // The ordinary stream parser uses JSON Value for compatibility. Parse just the receipt
+        // fields again so duplicate keys cannot collapse into a falsely unambiguous observation.
+        let Ok(event) = serde_json::from_str::<ModelObservationEvent<'_>>(raw) else {
+            self.invalid = true;
+            return;
+        };
+        let response = event.response.as_ref();
+        let body_id = response.and_then(|value| value.id);
+        let wire_id = event.response_id;
+        let id_value = |value: &RawValue| serde_json::from_str::<String>(value.get()).ok();
+        let body_id_text = body_id.and_then(id_value);
+        let wire_id_text = wire_id.and_then(id_value);
+        if (body_id.is_some() && body_id_text.is_none())
+            || (wire_id.is_some() && wire_id_text.is_none())
+            || (body_id_text.is_some() && wire_id_text.is_some() && body_id_text != wire_id_text)
+        {
+            self.invalid = true;
+            return;
+        }
+        let id = body_id_text.as_deref().or(wire_id_text.as_deref());
+        match kind {
+            "response.created" => {
+                if let Some(id) = id {
+                    self.bind_id(id);
+                }
+            }
+            "response.metadata" => {
+                // Metadata without a response ID can belong to a prior request on the same socket.
+                if id.is_some_and(|id| self.bind_id(id)) {
+                    self.observe_headers(event.headers.as_ref());
+                    self.observe_headers(response.and_then(|value| value.headers.as_ref()));
+                }
+            }
+            "response.completed" => {
+                if self.completed || !id.is_some_and(|id| self.bind_id(id)) {
+                    self.invalid = true;
+                    return;
+                }
+                self.completed = true;
+                if response
+                    .and_then(|value| value.status)
+                    .is_some_and(|value| id_value(value).as_deref() != Some("completed"))
+                {
+                    self.invalid = true;
+                    return;
+                }
+                self.observe_headers(event.headers.as_ref());
+                self.observe_headers(response.and_then(|value| value.headers.as_ref()));
+                if let Some(model) = response.and_then(|value| value.model) {
+                    let model = id_value(model);
+                    self.observe_model(model.as_deref(), ResponseModelSource::ResponseBody);
+                }
+            }
+            _ => (),
+        }
+    }
+
+    pub(crate) fn invalidate(&mut self) {
+        self.invalid = true;
+    }
+
+    pub(crate) fn process(
+        &mut self,
+        event: ResponsesStreamEvent,
+        raw: &str,
+    ) -> Result<Option<ResponseEvent>, ResponsesEventError> {
+        let terminal = event.kind() == "response.completed";
+        self.observe_event(event.kind(), raw);
+        let mut event = process_responses_event(event)?;
+        if let Some(ResponseEvent::Completed {
+            model_observation,
+            response_id,
+            ..
+        }) = &mut event
+            && terminal
+            && !self.invalid
+            && self.response_id.as_deref() == Some(response_id.as_str())
+        {
+            *model_observation = self.observation.take();
+        }
+        Ok(event)
+    }
+}
