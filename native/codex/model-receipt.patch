+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn responses_websocket_model_observation_does_not_cross_response_boundaries() {
+    skip_if_no_network!();
+
+    let server = start_websocket_server_with_headers(vec![WebSocketConnectionConfig {
+        requests: vec![
+            vec![
+                ev_response_created("resp-1"),
+                json!({"type": "response.metadata", "response_id": "resp-1", "headers": {"x-openai-model": "gpt-6-astra"}}),
+                ev_completed("resp-1"),
+            ],
+            vec![ev_response_created("resp-2"), ev_completed("resp-2")],
+        ],
+        response_headers: vec![("OpenAI-Model".to_string(), "gpt-6-astra".to_string())],
+        accept_delay: None,
+        close_after_requests: true,
+    }]).await;
+    let harness = websocket_harness_for_codex_backend(&server).await;
+    for (id, expected) in [("resp-1", Some("gpt-6-astra")), ("resp-2", None)] {
+        let mut session = harness.client.new_session();
+        let prompt = prompt_with_input(vec![message_item("fixture")]);
+        let metadata = turn_metadata(&harness, /*turn_id*/ None);
+        let mut stream = session
+            .stream(
+                &prompt,
+                &harness.model_info,
+                &harness.session_telemetry,
+                harness.effort.clone(),
+                harness.summary,
+                /*service_tier*/ None,
+                &metadata,
+                &InferenceTraceContext::disabled(),
+            )
+            .await
+            .expect("local websocket stream");
+        let observed = loop {
+            let event = stream
+                .next()
+                .await
+                .expect("fixture completion")
+                .expect("fixture response event");
+            if let ResponseEvent::Completed {
+                response_id,
+                model_observation,
+                ..
+            } = event
+            {
+                assert_eq!(response_id, id);
+                break model_observation;
+            }
+        };
+        assert_eq!(
+            observed.map(|model| (model.model, model.source)),
+            expected.map(|model| {
+                (
+                    model.to_string(),
+                    codex_protocol::protocol::ResponseModelSource::ResponseHeader,
+                )
+            })
+        );
+    }
+    assert_eq!(server.handshakes().len(), 1);
+    assert_eq!(server.single_connection().len(), 2);
+    server.shutdown().await;
+}
