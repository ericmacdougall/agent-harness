+def short_flag(tok):
+    """A single-dash token, read the way pflag reads a shorthand cluster (code review F3): booleans chain, `e` anywhere
+    in the chain is an env flag (-de, -ieK=V), and the first value-taking shorthand ends the chain."""
+    short = tok[:2]
