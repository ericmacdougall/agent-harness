+    expect(() => lstatSync(join(root, `${ENVFILE_DIR_PREFIX}link`))).toThrow();
+    expect(readFileSync(join(outside, 'keep'), 'utf8')).toBe('keep');
+  });
+});
+
+describe('server: request env 400, base env 501, never docker', () => {
