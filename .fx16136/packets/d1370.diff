+def _move_intel_to_labels(vm, held):
+    p = vm / 'compose.yaml'; t = p.read_text()
+    line = next(l for l in t.split('\n') if l.startswith('      JOB_IMAGE_INTELLIGENCE_WORKER:'))
+    new = '      JOB_IMAGE_INTELLIGENCE_WORKER: "" # held' if held else line
