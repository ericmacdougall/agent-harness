+    t = t.replace('  job-dispatcher-create-guard:\n    image: goodqa-job-dispatcher:base\n',
+                  '  job-dispatcher-create-guard:\n    image: goodqa-job-dispatcher:base\n    labels:\n' + new + '\n')
+    p.write_text(t)
