{
  "manifest_version": 3,
  "name": "Agent Harness — Open TUI",
  "version": "0.1.0",
  "description": "Open the current ChatGPT or Claude chat as a private reference in the local Go TUI.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": {"default_title": "Open this chat in the Go TUI", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"}
}
