#!/bin/sh
# agent-harness switch shim: `harness off [--reason TEXT] [--keep-services]`, `harness on`, `harness status`,
# `harness floor-check` (docs/off-switch.md). Installed by install.py at ~/.agent-harness/bin/harness.
# It answers these four words and nothing else.
case "$1" in
  off|on|status|floor-check)
    for f in "$HOME/.claude/hooks/ah_switch.py" "$HOME/.codex/agent-harness/ah_switch.py"; do
      [ -f "$f" ] && exec python3 "$f" "$@"
    done
    echo "harness: ah_switch.py is not installed (run install.py --apply)" >&2
    exit 1 ;;
esac
echo "usage: harness off [--reason TEXT] [--keep-services] | on | status | floor-check" >&2
exit 2
