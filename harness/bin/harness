#!/bin/sh
# agent-harness switch shim: `harness off [--reason TEXT] [--services]`, `harness on`, `harness status`,
# `harness floor-check [--repair]` (docs/off-switch.md). Installed by install.py at ~/.agent-harness/bin/harness.
# Any other word goes to a Go `harness` binary elsewhere on PATH (cmd/harness), when there is one.
case "$1" in
  off|on|status|floor-check|-h|--help|"")
    for f in "$HOME/.claude/hooks/ah_switch.py" "$HOME/.codex/agent-harness/ah_switch.py"; do
      [ -f "$f" ] && exec python3 "$f" "$@"
    done
    echo "harness: ah_switch.py is not installed (run install.py --apply)" >&2
    exit 1 ;;
esac
self=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
IFS=:
for d in $PATH; do
  [ -n "$d" ] && [ "$d" != "$self" ] && [ -x "$d/harness" ] && exec "$d/harness" "$@"
done
echo "harness: unknown command '$1' (try: harness off | on | status | floor-check)" >&2
exit 2
