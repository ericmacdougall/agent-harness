{
  "_doc": "Policy for kill_guard.py (GoodQA #14506). mode: enforce | warn | off. Verb lists are matched against the basename of the command after wrapper, alias, quote and ANSI-C decoding by command_guard's parser.",
  "mode": "enforce",
  "broad_verbs": ["pkill", "killall", "killall5", "skill", "slay", "pkill-all"],
  "windows_verbs": ["taskkill", "stop-process", "spps", "wmic"],
  "service_kill": {"systemctl": ["kill"], "launchctl": ["kill"], "loginctl": ["kill-session", "kill-user"]},
  "script_kill_pattern": "os\\.kill|os\\.killpg|pthread_kill|process\\.kill\\(|Process\\.kill|psutil|\\bpkill\\b|\\bkillall\\b|\\btaskkill\\b",
  "pid_finders": ["pgrep", "pidof", "ps", "lsof", "fuser", "pstree", "cat", "awk", "grep"],
  "ledger_max_lines": 2000,
  "child_timeout_seconds": 10
}
