{
  "_comment": "Copy to commit_policy.local.json beside commit_policy.json (untracked; never overwritten by the installer). Any key here replaces the shipped value; objects merge. mode: warn (default, form problems never block) or strict (every rule blocks). merge_gate: override any merge-gate number, e.g. small_change_lines.",
  "mode": "warn",
  "merge_gate": {
    "small_change_lines": 150
  },
  "backstop_repos": [
    "github\\.com[:/]your-org/"
  ],
  "ticket_systems": {
    "goodqa": {
      "repos": [
        "github\\.com[:/]your-org/"
      ],
      "org_id": "00000000-0000-4000-8000-000000000000",
      "key_file": "~/.claude/goodqa-hive/member.key",
      "unreachable_projects": [],
      "unreachable_reason": ""
    }
  }
}
