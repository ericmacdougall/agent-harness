{
  "version": 1,
  "modes": {
    "secret_dump": "enforce",
    "log_delete": "enforce",
    "broad_kill": "warn"
  },
  "limits": {
    "max_command_bytes": 262144,
    "max_depth": 8,
    "max_nodes": 600000,
    "max_seconds": 3.0,
    "max_stdin_bytes": 4194304
  },
  "protected_log_roots": [
    "{home}/.claude/projects",
    "{home}/.claude/wals",
    "{home}/.claude/sessions",
    "{home}/.claude/transcripts",
    "{home}/.claude/history.jsonl",
    "{home}/.codex/sessions",
    "{home}/.codex/archived_sessions",
    "{home}/.codex/history*"
  ],
  "protected_work_wal_regex": "^{home}/\\.agent-harness/work/[^/]+/(?:.*/)?(?:wals?|wal[^/]*|[^/]*\\.wal\\.jsonl)(?:/.*)?$",
  "ancestor_roots": [
    "{home}",
    "{home}/.claude",
    "{home}/.codex",
    "{home}/.agent-harness",
    "{home}/.agent-harness/work"
  ],
  "state_files": [
    "{home}/.agent-harness/state/log-delete-ok.json",
    "{home}/.agent-harness/state/log-delete.key"
  ],
  "credential_path_regexes": [
    "(^|/)\\.config/rclone/rclone\\.conf$",
    "(^|/)rclone\\.conf$",
    "(^|/)\\.aws/credentials$",
    "(^|/)\\.aws/sso/cache/[^/]+$",
    "(^|/)\\.ssh/id_[^/]*$",
    "(^|/)id_(?:rsa|dsa|ecdsa|ed25519)$",
    "\\.p8$",
    "\\.key$",
    "\\.pem$",
    "\\.p12$",
    "\\.pfx$",
    "(^|/)\\.env(?:\\.[^/]*)?$",
    "(^|/)\\.claude/\\.credentials\\.json$",
    "(^|/)\\.codex/auth\\.json$",
    "(^|/)\\.npmrc$",
    "(^|/)\\.netrc$",
    "(^|/)\\.pgpass$",
    "(^|/)\\.git-credentials$",
    "(^|/)\\.docker/config\\.json$",
    "(^|/)\\.config/gh/hosts\\.yml$",
    "(^|/)\\.kube/config$",
    "(^|/)\\.vault-token$",
    "(^|/)\\.config/gcloud/(?:credentials\\.db|access_tokens\\.db|application_default_credentials\\.json|legacy_credentials/.*)$",
    "(^|/)\\.gnupg/(?:private-keys-v1\\.d/.*|secring\\.gpg)$",
    "^/proc/(?:self|[0-9]+|\\*)/environ$"
  ],
  "credential_allow_regexes": [
    "\\.pub$",
    "\\.env\\.(?:example|sample|template|dist|defaults)$",
    "-cert\\.pub$"
  ],
  "credential_dirs": [
    "{home}/.ssh",
    "{home}/.aws",
    "{home}/.config/rclone",
    "{home}/.claude/goodqa-hive",
    "{home}/.gnupg",
    "{home}/.docker",
    "{home}/.config/gh",
    "{home}/.config/gcloud",
    "{home}/.kube"
  ],
  "credential_samples": [
    "{home}/.ssh/id_rsa",
    "{home}/.ssh/id_ed25519",
    "{home}/.ssh/id_ecdsa",
    "{home}/.aws/credentials",
    "{home}/.config/rclone/rclone.conf",
    "{home}/.npmrc",
    "{home}/.netrc",
    "{home}/.docker/config.json",
    "{home}/.claude/goodqa-hive/member.key",
    "{home}/.config/gh/hosts.yml",
    "{home}/.claude/.credentials.json",
    "{home}/.codex/auth.json",
    "{home}/.pgpass",
    "{home}/.git-credentials",
    "{cwd}/.env"
  ],
  "secret_env_regex": "(?:SECRET|TOKEN|PASSWORD|PASSWD|PASSPHRASE|CREDENTIAL|APIKEY|ACCESSKEY|PRIVATEKEY)|(?:^|_)(?:KEY|PAT)(?:_|$)",
  "secret_env_exclude_regex": "(?:_FILE|_PATH|_DIR|_NAME|_COUNT|_LIMIT|_BUDGET|_URL|_ID|_TTL|_EXPIRY|_TIMEOUT)$|^(?:KEYCHAIN|SSH_AUTH_SOCK)",
  "rclone_blocked_config": [
    "show",
    "dump",
    "reconnect"
  ],
  "kill": {
    "min_pattern_length": 12,
    "generic_names": [
      "python",
      "python3",
      "node",
      "nodejs",
      "claude",
      "codex",
      "unittest",
      "pytest",
      "chrome",
      "chromium",
      "ssh",
      "sshd",
      "bash",
      "sh",
      "zsh",
      "java",
      "ruby",
      "go",
      "npm",
      "pnpm",
      "yarn",
      "tmux",
      "git",
      "rclone",
      "docker",
      "electron",
      "code",
      "safari",
      "firefox",
      "tests",
      "test",
      "server",
      "worker",
      "agent",
      "harness",
      "deliver",
      "peer_review"
    ]
  },
  "marker": {
    "default_ttl_seconds": 900,
    "max_ttl_seconds": 86400,
    "max_walk_entries": 200000,
    "max_walk_seconds": 2.0,
    "max_hash_bytes": 21474836480
  }
}
