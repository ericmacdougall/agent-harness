<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.ericmacdougall.log-backup</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>@HOME@/.agent-harness/bin/log-backup.sh</string></array>
<key>StartInterval</key><integer>900</integer>
<key>RunAtLoad</key><true/>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
<key>StandardOutPath</key><string>@HOME@/.agent-harness/logs/log-backup.out</string>
<key>StandardErrorPath</key><string>@HOME@/.agent-harness/logs/log-backup.err</string>
<key>LowPriorityIO</key><true/><key>Nice</key><integer>10</integer>
</dict></plist>
