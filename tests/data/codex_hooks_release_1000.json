        ]
      },
      {
        "hooks": [
          {
            "command": "python3 /HOME/.codex/agent-harness/ah_hook.py autosave.py",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 /HOME/.codex/agent-harness/ah_hook.py wal.py hook",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 /HOME/.codex/agent-harness/ah_hook.py wal.py hook",
            "timeout": 10,
            "type": "command"
          }
        ]
