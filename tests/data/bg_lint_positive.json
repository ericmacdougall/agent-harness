[
  {"id": "incident-14513", "command": "cmd1; nohup suite > run.log 2>&1 & echo started", "expect": "success-echo"},
  {"id": "semicolon-launched", "command": "prep; echo launched", "expect": "success-echo"},
  {"id": "amp-running", "command": "nohup ./suite & echo running", "expect": "success-echo"},
  {"id": "amp-newline-done", "command": "nohup ./suite &\necho done", "expect": "success-echo"},
  {"id": "printf-ok", "command": "make test; printf 'ok\\n'", "expect": "success-echo"},
  {"id": "semicolon-uppercase", "command": "build; echo STARTED the suite", "expect": "success-echo"},
  {"id": "ssh-remote-side", "command": "setup_step; echo suite started on dev2", "expect": "success-echo"},
  {"id": "wait-then-ls", "command": "while kill -0 $PID 2>/dev/null; do sleep 60; done; ls VERIFIED", "expect": "wait-loop-tail"},
  {"id": "wait-then-tail", "command": "while kill -0 $PID; do sleep 60; done\ntail -3 verify.log", "expect": "wait-loop-tail"},
  {"id": "wait-then-cat", "command": "until ! pgrep -f suite >/dev/null; do sleep 5; done; cat result.txt", "expect": "wait-loop-tail"},
  {"id": "body-ends-ls", "command": "while kill -0 $PID; do sleep 5; ls out; done", "expect": "wait-loop-tail"},
  {"id": "systemd-poll", "command": "while systemctl is-active unit.service >/dev/null; do sleep 10; done; tail -20 log", "expect": "wait-loop-tail"},
  {"id": "old-loop-14472", "command": "while bash -c \"$ALIVE_CMD\"; do sleep 60; done\ntail -3 verify.log\nls VERIFIED-dropbox\ncat VERIFIED-dropbox\nls -l \"$PASSFILE\"", "expect": "wait-loop-tail"},
  {"id": "pipestatus-after-subst", "command": "H=$(fetch | decrypt | sha256sum | cut -d' ' -f1); echo \"${PIPESTATUS[@]}\"", "expect": "pipestatus"},
  {"id": "pipestatus-backtick", "command": "H=`a | b`\n[ \"${PIPESTATUS[0]}\" = 0 ]", "expect": "pipestatus"},
  {"id": "pipestatus-local", "command": "f() { local out=$(a | b); [ \"${PIPESTATUS[1]}\" = 0 ] || return 1; }", "expect": "pipestatus"}
