[
  {"id": "and-chain", "command": "cmd1 && nohup suite > run.log 2>&1 & echo pid"},
  {"id": "and-echo", "command": "cmd1 && echo started"},
  {"id": "echo-first", "command": "echo started"},
  {"id": "quoted-semicolon", "command": "echo \"prep; started\""},
  {"id": "non-success-echo", "command": "cmd1; echo $?"},
  {"id": "single-quoted-amp", "command": "echo 'a & done'"},
  {"id": "redirect-amp", "command": "suite > log 2>&1 && echo ok"},
  {"id": "bg-launch-helper", "command": "python3 ~/.claude/hooks/bg_job.py launch --name s --log s.log --deadline 20 -- ./suite"},
  {"id": "wait-helper", "command": "python3 ~/.claude/hooks/bg_job.py wait --name s --timeout 3600"},
  {"id": "loop-not-wait", "command": "for f in *.txt; do cat $f; done"},
  {"id": "loop-then-explicit-check", "command": "while kill -0 $PID; do sleep 5; done; python3 bg_job.py wait --name s"},
  {"id": "loop-ends-test", "command": "while kill -0 $PID; do sleep 5; done; test -f DONE"},
  {"id": "plain-ls", "command": "ls -l"},
  {"id": "pipestatus-direct", "command": "a | b | c > out; echo \"${PIPESTATUS[@]}\""},
  {"id": "pipefail", "command": "set -o pipefail; H=$(a | b | c)"},
  {"id": "subst-no-pipe-no-status", "command": "H=$(a | b); echo \"$H\""},
  {"id": "or-chain", "command": "cmd1 || echo failed"},
  {"id": "newline-echo-ordinary", "command": "cmd1\necho started"},
  {"id": "if-then-echo-done", "command": "if make build; then echo done; fi"},
  {"id": "for-do-echo-done", "command": "for f in a b; do echo done $f; done"},
  {"id": "ssh-clean-chain", "command": "ssh dev2 'cmd1 && nohup ./suite > r.log 2>&1 & echo pid'"},
  {"id": "comment-only-chain-text", "command": "# cmd1; echo started\ncmd1 && cmd2"},
  {"id": "empty", "command": ""},
  {"id": "bracket-trick-pgrep", "command": "while pgrep -f \"[t]sc --noEmit\"; do sleep 5; done"},
  {"id": "bracket-trick-ssh", "command": "ssh dev2 'while pgrep -f \"[t]sc --noEmit\" >/dev/null; do sleep 30; done'"},
  {"id": "pgrep-exact-name", "command": "while pgrep -x tsc >/dev/null; do sleep 5; done"},
  {"id": "pgrep-name-only", "command": "while pgrep node >/dev/null; do sleep 5; done"},
  {"id": "ps-grep-v-grep", "command": "while ps aux | grep 'vitest run' | grep -v grep; do sleep 10; done"},
  {"id": "pid-wait", "command": "while kill -0 $PID 2>/dev/null; do sleep 5; done"},
  {"id": "file-wait-timeout", "command": "timeout 600 bash -c 'until [ -f out.txt ]; do sleep 5; done'"},
  {"id": "file-wait-counter", "command": "i=0; until [ -f out.txt ] || [ $i -ge 120 ]; do sleep 5; i=$((i+1)); done"},
  {"id": "file-wait-seconds", "command": "until [ -f out.txt ] || [ $SECONDS -gt 600 ]; do sleep 5; done"},
  {"id": "file-wait-for-bounded", "command": "for i in $(seq 1 120); do [ -f out.txt ] && break; sleep 5; done"},
  {"id": "file-check-no-wait", "command": "if [ -f out.txt ]; then cat out.txt; fi"}
]
