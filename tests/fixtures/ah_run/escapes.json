{
  "_comment": "DATA ONLY. Strings asserted through ah_run.classify_escapes; never executed, never fed to a shell.",
  "refused": [
    {"id": "nohup-plain", "cmd": "nohup sleep 100"},
    {"id": "nohup-pipeline", "cmd": "echo hi | nohup cat"},
    {"id": "nohup-after-and", "cmd": "make build && nohup ./serve"},
    {"id": "nohup-env-prefix", "cmd": "FOO=1 nohup ./serve"},
    {"id": "setsid", "cmd": "setsid ./serve"},
    {"id": "setsid-via-sudo", "cmd": "sudo setsid ./serve"},
    {"id": "disown", "cmd": "sleep 100 & disown"},
    {"id": "trailing-amp", "cmd": "sleep 100 &"},
    {"id": "trailing-amp-after-chain", "cmd": "make build && ./serve &"},
    {"id": "amp-no-later-wait", "cmd": "sleep 1 & echo started"},
    {"id": "amp-wait-before", "cmd": "wait; sleep 100 &"},
    {"id": "subshell-amp-no-wait", "cmd": "(sleep 5 &)"},
    {"id": "screen", "cmd": "screen -dm ./serve"},
    {"id": "tmux", "cmd": "tmux new-session -d ./serve"},
    {"id": "at", "cmd": "echo ./job | at now + 1 minute"},
    {"id": "batch", "cmd": "batch < jobs.txt"},
    {"id": "crontab", "cmd": "crontab jobs.cron"},
    {"id": "launchctl-submit", "cmd": "launchctl submit -l x -- ./serve"},
    {"id": "launchctl-bootstrap", "cmd": "launchctl bootstrap gui/501 x.plist"},
    {"id": "launchctl-load", "cmd": "launchctl load -w x.plist"},
    {"id": "launchctl-kickstart", "cmd": "launchctl kickstart -k gui/501/x"},
    {"id": "systemd-run", "cmd": "systemd-run --user ./serve"},
    {"id": "open-a", "cmd": "open -a Safari"},
    {"id": "open-ga", "cmd": "open -g -a Terminal"},
    {"id": "osascript", "cmd": "osascript -e 'tell application \"Finder\" to activate'"},
    {"id": "ssh-f", "cmd": "ssh -f host ./serve"},
    {"id": "ssh-fN", "cmd": "ssh -fN -L 8080:localhost:80 host"},
    {"id": "ssh-remote-amp", "cmd": "ssh host './serve &'"},
    {"id": "ssh-remote-nohup", "cmd": "ssh host nohup ./serve"},
    {"id": "coproc", "cmd": "coproc ./serve"},
    {"id": "env-i", "cmd": "env -i ./serve"},
    {"id": "env-u-task", "cmd": "env -u AGENT_HARNESS_TASK ./serve"},
    {"id": "env-u-glued", "cmd": "env -uAGENT_HARNESS_SESSION ./serve"},
    {"id": "bash-c-nohup", "cmd": "bash -c 'nohup ./serve'"},
    {"id": "substitution-nohup", "cmd": "echo $(nohup ./serve)"},
    {"id": "unterminated-quote-is-parse-failure", "cmd": "echo 'unterminated"}
  ],
  "allowed": [
    {"id": "subshell-amp-then-wait", "cmd": "(sleep 5 &) ; wait"},
    {"id": "two-jobs-then-wait", "cmd": "cmd1 & cmd2; wait"},
    {"id": "and-or-chain", "cmd": "make build && make test || echo failed"},
    {"id": "heredoc-body-has-nohup", "cmd": "cat > t.py <<'EOF'\nimport os\nos.system('nohup x &')\nsetsid = 1\nEOF"},
    {"id": "comment-has-nohup", "cmd": "ls # nohup is mentioned here"},
    {"id": "redirect-amp", "cmd": "make test 2>&1 | tail -5"},
    {"id": "timeout-wrapper", "cmd": "timeout 30 sleep 1"},
    {"id": "quoted-words", "cmd": "echo 'nohup setsid tmux &' \"and disown\""},
    {"id": "ssh-plain-command", "cmd": "ssh host 'git log -1'"},
    {"id": "env-assignment-only", "cmd": "env FOO=1 make test"}
  ]
}
