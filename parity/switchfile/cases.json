   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "binary"
  },
  {
   "name": "binary is symlink",
