{
 "comment": "Shared by internal/impl (Go) and compat/pyfront (Python). Each case builds a temp HOME; binary is written by the test with mode and content, and its sha256 placed where impl says \"$SHA\". Decision: go | python | refuse. launcher_link builds dir/launcher as a symlink: shared -> shared/x (shared 0777), safe -> real, two_hop_shared -> shared/lnk -> real, relative_safe -> ./real.",
 "cases": [
  {
   "name": "missing file",
   "impl": null,
   "want": "python",
   "reason": "missing"
  },
  {
   "name": "flipped and valid",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "go"
  },
  {
   "name": "group not flipped",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "python"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "group"
  },
  {
   "name": "group absent",
   "impl": {
    "schema": 1,
    "groups": {},
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "group"
  },
  {
   "name": "unknown group value",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "rust"
    },
    "hosts": {
     "claude": {
