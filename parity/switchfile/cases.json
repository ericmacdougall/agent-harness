{
 "comment": "Shared by internal/impl (Go) and compat/pyfront (Python). Each case builds a temp HOME; binary is written by the test with mode and content, and its sha256 placed where impl says \"$SHA\". Decision: go | python | refuse.",
 "cases": [
  {
   "name": "missing file",
   "impl": null,
   "want": "python",
   "reason": "missing"
  },
  {
   "name": "flipped and valid",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "go"
  },
  {
   "name": "group not flipped",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "python"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "group"
  },
  {
   "name": "group absent",
   "impl": {
    "schema": 1,
    "groups": {},
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "group"
  },
  {
   "name": "unknown group value",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "rust"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "invalid"
  },
  {
   "name": "wrong schema",
   "impl": {
    "schema": 2,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "invalid"
  },
  {
   "name": "not json",
   "raw": "{",
   "want": "python",
   "reason": "invalid"
  },
  {
   "name": "file mode 0644",
   "file_mode": 420,
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "unsafe"
  },
  {
   "name": "file is symlink",
   "file_symlink": true,
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "unsafe"
  },
  {
   "name": "host missing",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "codex": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "host"
  },
  {
   "name": "binary not the launcher path",
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$OTHER",
      "sha256": "$SHA"
     }
    }
   },
   "want": "python",
   "reason": "binary"
  },
  {
   "name": "binary group-writable",
