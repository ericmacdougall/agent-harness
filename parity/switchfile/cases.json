  {
   "name": "hop marker would loop",
   "env": {
    "AGENT_HARNESS_DISPATCHED": "go->py"
   },
   "impl": {
    "schema": 1,
    "groups": {
     "wal": "go"
    },
    "hosts": {
     "claude": {
      "binary": "$BIN",
      "sha256": "$SHA"
     }
    }
   },
   "want": "refuse",
   "reason": "loop"
  },
  {
